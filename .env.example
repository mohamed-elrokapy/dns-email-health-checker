# Copy to .env and adjust. docker compose reads this file.

# Address Caddy serves. ":80" serves plain HTTP on the published port.
# Set a real domain such as health.example.com to get automatic HTTPS from Let's Encrypt.
SITE_ADDRESS=:80

# Port on the host that maps to Caddy's port 80.
HTTP_PORT=8080

# API settings (see backend/app/main.py).
RATE_LIMIT_PER_MINUTE=20
DNS_TIMEOUT_SECONDS=3
# Comma separated resolvers to use instead of the container default, for example 1.1.1.1,9.9.9.9
DNS_NAMESERVERS=
# Only set to true when the API runs behind a proxy you control (the compose file does).
TRUST_PROXY_HEADERS=true
# Origins allowed to call the API from a browser. Not needed behind Caddy (same origin).
CORS_ORIGINS=http://localhost:3000
