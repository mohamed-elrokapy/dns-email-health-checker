# One entry point for the browser: /api/* goes to the API, everything else to the web app.
# SITE_ADDRESS=:80 serves plain HTTP. A real domain name gets automatic HTTPS.
{$SITE_ADDRESS::80} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
